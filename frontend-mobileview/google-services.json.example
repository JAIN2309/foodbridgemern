{
  "_comment": "Download the real google-services.json from Firebase Console (Project Settings > Android > Download config file) and place it here as google-services.json",
  "_steps": [
    "1. Go to https://console.firebase.google.com",
    "2. Create project 'FoodBridge' (or use existing)",
    "3. Add Android app with package name: com.foodbridge.mobile",
    "4. Download google-services.json",
    "5. Place it in frontend-mobileview/ (same folder as this file)",
    "6. Add google-services.json to .gitignore"
  ]
}
